<?xml version="1.0" encoding="utf-8"?>
<packages>
  <!-- v1.4.0.32: the metapackage is REMOVED from packages.config. It ships no compile-time
       assemblies for UAP; its netcore50 facade DLLs (System.Runtime, Version=4.0.0.0) sitting
       in ..\packages are picked up by MSBuild's simple-name resolution and SHADOW the correct
       SDK reference-assembly facades -> XamlCompiler WMC1006 "Cannot resolve System.Runtime.dll"
       + WMC9999 "Type universe cannot resolve assembly: System.Runtime". The classic UAP project
       system resolves ALL BCL/WinRT references itself from the Windows SDK (UnionMetadata +
       ReferenceAssemblies); NuGet is needed only for third-party libs. Runtime .NET Core IL
       still comes from the machine-wide VC++ 2015-2019 UWP Desktop runtime (VS2017 installs it).
       If restore ever needs to be re-enabled, do NOT return this line - see BUILD_VS2017.md. -->
  <package id="newtonsoft.json" version="12.0.3" targetFramework="uap10.0.15063" />
  <package id="documentformat.openxml" version="2.9.1" targetFramework="uap10.0.15063" />
  <package id="microsoft.net.native.compiler" version="1.7.3" targetFramework="uap10.0.15063" />
</packages>
