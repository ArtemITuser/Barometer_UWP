<?xml version="1.0" encoding="utf-8"?>
<packages>
  <package id="microsoft.netcore.universalwindowsplatform" version="6.0.8" targetFramework="uap10.0.15063" />
  <package id="newtonsoft.json" version="12.0.3" targetFramework="uap10.0.15063" />
  <package id="documentformat.openxml" version="2.9.1" targetFramework="uap10.0.15063" />
  <package id="microsoft.net.native.compiler" version="1.7.3" targetFramework="uap10.0.15063" />
  <!-- v1.4.0.31: the portable-compat metapackage is what wires mscorlib into the
       NETFX_CORE compile universe via the standard nuget.g.props pipeline. Without it
       every netcore50 facade (System.Runtime etc.) type-forwards to an unreferenced
       mscorlib -> CS0012 "add a reference to mscorlib, Version=4.0.0.0" cascade and
       CS0234 System.CodeDom missing in the XamlCompiler-generated *.g.i.cs files. -->
  <!-- v1.4.0.31: minimal honest set. The v1.4.0.30 experiment proved that manually
       injecting netcore50 facade <Reference>s into a UAP project BREAKS the build:
       facades type-forward to mscorlib which the NETFX_CORE universe does not load
       from those paths -> CS0012 "add a reference to mscorlib 4.0.0.0" cascade (81 err)
       + CS0234 System.CodeDom missing in *.g.i.cs. All BCL/WinRT references for a UAP
       project come automatically from Windows.WinMD + SDK Unification at RAR time;
       NuGet packages are needed here only for third-party libs and the .NET Native
       compiler. Transitive closure of the metapackage is restored by nuget.exe itself. -->
</packages>
