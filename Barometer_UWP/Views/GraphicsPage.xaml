<Page
    x:Class="Barometer_UWP.Views.GraphicsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Barometer_UWP.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:lvc="using:LiveCharts.UWP"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Acrylic background -->
        <StackPanel Grid.Row="0" Padding="20" Background="{ThemeResource SystemControlAcrylicElementBrush}">
            <TextBlock Text="Pressure Graphics" 
                       Style="{ThemeResource HeaderTextBlockStyle}" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,10"/>
        </StackPanel>

        <!-- Chart Area -->
        <Grid Grid.Row="1" Padding="20">
            <lvc:CartesianChart x:Name="PressureChart" 
                                Series="{x:Bind ViewModel.SeriesCollection, Mode=OneWay}"
                                DisableAnimations="False"
                                Hoverable="True"
                                DataTooltip="{x:Bind ViewModel.ChartTooltip, Mode=OneWay}">
                <lvc:CartesianChart.AxisX>
                    <lvc:Axis Title="Time" Labels="{x:Bind ViewModel.DateTimeLabels, Mode=OneWay}" 
                              ShowLabels="True"/>
                </lvc:CartesianChart.AxisX>
                <lvc:CartesianChart.AxisY>
                    <lvc:Axis Title="Pressure" LabelFormatter="{x:Bind ViewModel.YFormatter, Mode=OneWay}"/>
                </lvc:CartesianChart.AxisY>
            </lvc:CartesianChart>
        </Grid>

        <!-- Controls -->
        <StackPanel Grid.Row="2" Padding="20" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Live Mode" 
                    Command="{x:Bind ViewModel.ToggleLiveModeCommand}" 
                    Margin="0,0,10,0"/>
            <Button Content="Export PNG" 
                    Command="{x:Bind ViewModel.ExportPngCommand}" 
                    Margin="0,0,10,0"/>
            <Button Content="Export XLSX" 
                    Command="{x:Bind ViewModel.ExportXlsxCommand}" 
                    Margin="0,0,10,0"/>
            <ComboBox x:Name="PeriodComboBox" 
                      ItemsSource="{x:Bind ViewModel.PeriodOptions, Mode=OneWay}" 
                      SelectedItem="{x:Bind ViewModel.SelectedPeriod, Mode=TwoWay}" 
                      Margin="0,0,10,0"/>
            <Button Content="Share" 
                    Command="{x:Bind ViewModel.ShareCommand}" 
                    Margin="0,0,10,0"/>
        </StackPanel>
    </Grid>
</Page>