  <ItemGroup>
    <!-- Mobile-compatible package set (Win10 15063 ARM/ARM64): no OxyPlot.UWP,
         no Microsoft.Graph 4.x / MSAL 4.x / Community Toolkit 7.x (unsupported).
         packages.config style: required for classic UAP csproj on VS2017 and modern
         MSBuild images (PackageReference in legacy project system does not wire the
         UWP .NET Native toolchain -> WinRT projections missing at compile time).
         NOTE: HintPaths must be absolute-safe: CI runners have a global Newtonsoft.Json
         under Program Files that MSBuild's simple-name resolution can shadow relative
         ..\packages paths with (wrong CLR flavor -> WMC1006 System.Runtime unresolved).
         $(MSBuildThisFileDirectory) pins them to the restored packages folder. -->
    <Reference Include="Newtonsoft.Json">
      <!-- v1.4.0.13b: the folder 'portable-net45+win8' does not exist in 12.0.3 (real name is
           portable-net45+win8+wp8+wpa81); netstandard1.3 is the correct choice for UAP 15063+. -->
      <HintPath>$(MSBuildThisFileDirectory)..\packages\newtonsoft.json.12.0.3\lib\netstandard1.3\Newtonsoft.Json.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="DocumentFormat.OpenXml">
      <HintPath>$(MSBuildThisFileDirectory)..\packages\documentformat.openxml.2.9.1\lib\netstandard1.3\DocumentFormat.OpenXml.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <!-- XamlCompiler (WMC) type universe does NOT follow NuGet transitive refs of the
         UAP metapackage: without explicit References below, every {Binding ...} in XAML
         fails with WMC0003 "cannot resolve System.Runtime.WindowsRuntime.UI.Xaml /
         System.ObjectModel". These are the WinRT INotifyPropertyChanged projection and
         ObservableCollection facades used by all binding-enabled pages. -->
    <!-- NOTE: this facade package ships ONLY reference assemblies (lib/ has _._
         placeholders; the real implementation lives in the .NET runtime). The DLL
         is under ref/netcore50, NOT lib/uap10.0_* — previous HintPath pointed to a
         nonexistent path, causing MSB3245 + 100+ WMC0003 errors on every {Binding}. -->
    <Reference Include="System.Runtime.WindowsRuntime.UI.Xaml">
      <HintPath>$(MSBuildThisFileDirectory)..\packages\system.runtime.windowsruntime.ui.xaml.4.0.1\ref\netcore50\System.Runtime.WindowsRuntime.UI.Xaml.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.ObjectModel">
      <!-- v1.4.0.12c: use the netcore50 facade (type-forwarded to mscorlib), NOT the
           netstandard1.3 implementation assembly. Referencing the ns1.3 dll injects a
           duplicate System.Object into the compile universe -> CS0012 "add a reference to
           mscorlib" + CS0234 System.Linq/System.Collections missing across all files. -->
      <HintPath>$(MSBuildThisFileDirectory)..\packages\system.objectmodel.4.0.12\ref\netcore50\System.ObjectModel.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
