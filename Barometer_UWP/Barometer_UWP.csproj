  <ItemGroup>
    <!-- Mobile-compatible package set (Win10 15063 ARM/ARM64): no OxyPlot.UWP,
         no Microsoft.Graph 4.x / MSAL 4.x / Community Toolkit 7.x (unsupported).
         packages.config style: required for classic UAP csproj on VS2017 and modern
         MSBuild images (PackageReference in legacy project system does not wire the
         UWP .NET Native toolchain -> WinRT projections missing at compile time).
         NOTE: HintPaths must be absolute-safe: CI runners have a global Newtonsoft.Json
         under Program Files that MSBuild's simple-name resolution can shadow relative
         ..\packages paths with (wrong CLR flavor -> WMC1006 System.Runtime unresolved).
         $(MSBuildThisFileDirectory) pins them to the restored packages folder. -->
    <Reference Include="Newtonsoft.Json">
      <!-- v1.4.0.13b: the folder 'portable-net45+win8' does not exist in 12.0.3 (real name is
           portable-net45+win8+wp8+wpa81); netstandard1.3 is the correct choice for UAP 15063+. -->
      <HintPath>$(MSBuildThisFileDirectory)..\packages\newtonsoft.json.12.0.3\lib\netstandard1.3\Newtonsoft.Json.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="DocumentFormat.OpenXml">
      <HintPath>$(MSBuildThisFileDirectory)..\packages\documentformat.openxml.2.9.1\lib\netstandard1.3\DocumentFormat.OpenXml.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <!-- v1.4.0.31: NO manual BCL/facade <Reference>s here. Postmortem of v1.4.0.30:
         hand-injecting netcore50 facade DLLs (System.ObjectModel, System.Runtime.WindowsRuntime*,
         System.Runtime, ...) from ..\packages corrupts the NETFX_CORE compile universe:
         the facades type-forward to mscorlib 4.0.0.0 which UAP resolution cannot load
         from those paths -> CS0012 "add a reference to mscorlib" cascade (81 errors),
         CS0234 System.CodeDom missing in *.g.i.cs, CS0122 IXmlNodeList accessibility.
         In a correct UAP project ALL BCL/WinRT references (mscorlib-equivalent,
         System.Runtime, System.ObjectModel, System.Runtime.WindowsRuntime[.UI.Xaml],
         System.Private.Uri, ...) are supplied automatically by the Windows SDK
         reference assemblies + Platform.winmd unification inside
         Microsoft.Windows.UI.Xaml.CSharp.targets. Only third-party libs need explicit
         wiring (Newtonsoft.Json / DocumentFormat.OpenXml above). The earlier WMC0003/
         WMC1006 symptoms were caused solely by ..\packages not being restored at all -
         fixed honestly by EnsurePackagesRestored + restore-before-build, not by faking
         framework refs. -->
  </ItemGroup>
