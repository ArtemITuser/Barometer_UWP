  <!-- packages.config NuGet wiring: without these imports the restored metapackage
       Microsoft.NETCore.UniversalWindowsPlatform (WinRT projections + System.Runtime facade)
       is never referenced at compile time -> WMC1006 'System.Runtime cannot be resolved'.
       Condition guards keep VS2017 local builds working when obj\nuget.g.props was generated
       by a prior nuget.exe restore. -->
  <!-- v1.4.0.19 CI fallback: if obj/*.nuget.g.props was NOT generated (nuget.exe CLI
       does not write it for bare packages.config), manually reference the netcore50
       type-forwarded facades from the restored packages folder. Without these the
       compile universe loses mscorlib unification -> CS0012 "add a reference to
       mscorlib" cascade across App.xaml.cs/ChartRenderer/WriteableBitmapEx.
       Condition keeps VS2017 local builds untouched (g.props exists there). -->
  <PropertyGroup Condition="!Exists('$(MSBuildProjectDirectory)\obj\$(MSBuildProjectName).nuget.g.props')">
    <_PkgRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\packages'))</_PkgRoot>
  </PropertyGroup>
