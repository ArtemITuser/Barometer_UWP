  <!-- v1.4.0.37 ARCHITECTURE CLEANUP (audit findings):
       (a) the NuGet self-heal restore machinery (_NuGetExe/_NuGetTasksAssembly/
           UsingTask NuGetRestoreTask/EnsurePackagesRestored) is REMOVED - the project
           has no compile-time package dependencies; a stale NuGetTasks.dll path in a
           UsingTask could hard-fail project load on machines with a different VS
           layout (IDE0006 class). Restore of the .NET Native compiler package, if ever
           needed for Release, is done manually via install_deps.cmd.
       (b) the duplicate old PurgeStaleRestoreState target (v1.4.0.35) is removed; the
           single hardened copy lives at the bottom of this file. -->

  <!-- ================= v1.4.0.37: hardened build-state hygiene =================
       The v1.4.0.36 "RejectPackageFacadeShadowReferences" firewall is REMOVED for
       good: it matched ReferencePath entries by SIMPLE NAME against the SDK facade
       list, so it would strip the LEGITIMATE Windows-SDK copies of System.Runtime.dll
       etc. and itself guarantee WMC9999. No name-based reference filtering belongs in
       this project; the only hygiene left is deleting stale generated obj state. -->
  <Target Name="PurgeStaleRestoreState" BeforeTargets="RunBeforeXamlCompilation;ResolveAssemblyReferences">
    <ItemGroup>
      <_StaleNuGetProps Include="$(MSBuildProjectDirectory)\obj\*.nuget.g.props;$(MSBuildProjectDirectory)\obj\*.nuget.g.targets;$(MSBuildProjectDirectory)\obj\*.nuget.cache" />
    </ItemGroup>
    <Delete Files="@(_StaleNuGetProps)" ContinueOnError="WarnAndContinue" />
    <RemoveDir Directories="$(MSBuildProjectDirectory)\obj\XamlPreCompile" Condition="Exists('$(MSBuildProjectDirectory)\obj\XamlPreCompile')" ContinueOnError="WarnAndContinue" />
    <Message Importance="high" Text="PurgeStaleRestoreState: removed residual obj restore state." Condition="'@(_StaleNuGetProps)' != ''" />
  </Target>
  <!-- v1.4.0.37 DIAGNOSTIC: prints the resolved reference set and the Windows SDK
       platform root used for facade resolution. Visible in the build output at
       normal verbosity ("Detailed build output" not required). If WMC9999 still
       fires on some machine, this dump pinpoints whether System.Runtime.dll is
       present in ReferencePath and from which path it came. -->
  <Target Name="DumpReferenceSet" BeforeTargets="RunBeforeXamlCompilation;Compile">
    <ItemGroup>
      <_DiagLines Include="@(ReferencePath)" />
    </ItemGroup>
    <Message Importance="high" Text="[v1.4.0.37 diag] TargetPlatformRoot=$(TargetPlatformRoot)" />
    <Message Importance="high" Text="[v1.4.0.37 diag] ReferencePath count: @(_DiagLines->Count())" Condition="'@(_DiagLines)' != ''" />
    <Message Importance="high" Text="[v1.4.0.37 diag] System.Runtime resolved: @(_DiagLines->WithMetadataValue('FileName','System.Runtime'))" />
    <Message Importance="high" Text="[v1.4.0.37 diag] ReferencePath is EMPTY - SDK facade injection did not run." Condition="'@(_DiagLines)' == ''" />
  </Target>
