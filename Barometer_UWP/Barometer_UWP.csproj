  <ItemGroup>
    <!-- v1.4.0.37 ARCHITECTURAL FIX (the real root cause). Postmortem of v1.4.0.29..36:
         at some point the STANDARD UWP project reference block was stripped from this
         csproj ("zero NuGet references" experiments in v34 went as far as deleting the
         SDK references too). A VS2017 UWP project MUST declare its framework references
         explicitly (System, System.Core, ..., Windows) exactly like the stock template;
         Microsoft.Windows.UI.Xaml.CSharp.targets does NOT synthesize them for classic
         projects. With no Reference items at all, ResolveAssemblyReferences hands the
         XamlCompiler an EMPTY type universe -> WMC1006 "Cannot resolve Assembly or
         Windows Metadata file 'System.Runtime.dll'" + WMC9999 "Type universe cannot
         resolve assembly: System.Runtime, Version=4.0.0.0". That is why the error
         survived every cache/packages/obj cleanup: there was nothing to resolve FROM.
         The block below is the canonical VS2017 UAP template set - resolved by simple
         name against the Windows 10 SDK (UnionMetadata + facade dir), zero HintPath,
         zero NuGet. Do not add HintPath or packages\ paths back. -->
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Numerics" />
    <Reference Include="System.Numerics.Vectors" />
    <Reference Include="System.Runtime.InteropServices.WindowsRuntime" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="Windows" />
  </ItemGroup>
