  <!-- v1.4.0.31: the v1.4.0.19/20 fallback block that injected netcore50 facade
       <Reference>s when obj/*.nuget.g.props was absent is REMOVED. Evidence from the
       user's machine (v1.4.0.30): those HintPath references resolve fine but poison the
       NETFX_CORE compile universe -> CS0012 mscorlib cascade + CS0234 CodeDom + CS0122
       IXmlNodeList (81 errors on rebuild/deploy). The standard nuget.g.props/.targets
       imports below are the only supported packages.config wiring for UAP; combined with
       EnsurePackagesRestored they cover fresh machines without manual facade faking. -->
  <Import Project="$(MSBuildProjectDirectory)\obj\$(MSBuildProjectName).nuget.g.props" Condition="Exists('$(MSBuildProjectDirectory)\obj\$(MSBuildProjectName).nuget.g.props')" />
  <Import Project="$(MSBuildProjectDirectory)\obj\$(MSBuildProjectName).nuget.g.targets" Condition="Exists('$(MSBuildProjectDirectory)\obj\$(MSBuildProjectName).nuget.g.targets')" />
  <!-- v1.4.0.30: self-healing restore. Root cause of MSB3245 'component not found' x18 +
       WMC1006 'System.Runtime, Version=4.0.0.0 cannot be resolved' on fresh machines:
       the source-only zip ships WITHOUT the ..\packages folder and nuget.exe does not
       generate obj\*.nuget.g.props for bare packages.config projects, so every facade
       HintPath above resolves to a nonexistent path until a manual restore is run.
       This target fires before ResolveAssemblyReferences and runs nuget restore itself
       (via VS-bundled NuGetTasks assembly - no nuget.exe needed on PATH). If neither
       nuget.exe nor the VS assembly is found it fails with an actionable message
       instead of the cryptic 20 unresolved-reference diagnostics. -->
  <PropertyGroup>
    <_NuGetExe Condition="'$(_NuGetExe)'=='' And Exists('$(MSBuildThisFileDirectory)..\.nuget\nuget.exe')">$(MSBuildThisFileDirectory)..\.nuget\nuget.exe</_NuGetExe>
    <_NuGetTasksAssembly>$([MSBuild]::ValueOrDefault('$(VsInstallRoot)','C:\Program Files (x86)\Microsoft Visual Studio'))\MSBuild\Microsoft\nuget10\NuGetTasks.dll</_NuGetTasksAssembly>
    <!-- v1.4.0.32: WMC9999 "Type universe cannot resolve assembly: System.Runtime,
         Version=4.0.0.0" postmortem. Root cause was the Microsoft.NETCore.UniversalWindowsPlatform
         metapackage in packages.config: its netcore50 facade DLLs shadow the Windows SDK
         reference assemblies during MSBuild/XamlCompiler simple-name resolution. The fix is
         removing the metapackage from packages.config (done in v1.4.0.32) - a correct UAP
         compile sees ONLY the SDK reference assemblies for BCL names. The StripPackageFacadeShadows
         belt added in v1.4.0.32 was itself broken (MSB4092: item batching @(PackageConflictFacadeNames)
         inside a target-level Condition is illegal) and functionally a no-op (removing Reference
         items after ResolveAssemblyReferences does not affect the produced ReferencePath), so it is
         removed in v1.4.0.33. If a stale packages\microsoft.netcore.universalwindowsplatform folder
         survives from an older restore, delete the whole packages folder - the property below only
         silences platform-item architecture warnings, it does NOT filter references. -->
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureOfPlatformItem>false</ResolveAssemblyWarnOrErrorOnTargetArchitectureOfPlatformItem>
  </PropertyGroup>
  <!-- NuGetTasks self-heal restore (used by EnsurePackagesRestored below) is only wired
       when the VS-bundled assembly actually exists; on machines without it, nuget.exe at
       ..\.nuget\nuget.exe or a manual restore is used instead. -->
  <UsingTask TaskName="NuGetRestoreTask" AssemblyFile="$(_NuGetTasksAssembly)" Condition="!Exists('$(_NuGetExe)') And Exists('$(_NuGetTasksAssembly)')" />
  <!-- v1.4.0.33: StripPackageFacadeShadows REMOVED. Two defects: (a) MSB4092 - an
       item-batching expression @(PackageConflictFacadeNames) is illegal inside a
       target-level Condition (conditions cannot batch), which broke project load;
       (b) even rewritten with batching, removing Reference items AFTER
       ResolveAssemblyReferences does not touch the already-produced ReferencePath,
       so the target was a no-op for its purpose anyway. The real fix stays in
       packages.config (metapackage dropped in v1.4.0.32): with no netcore50 facade
       DLLs on disk there is nothing to shadow the SDK reference assemblies. -->
  <!-- v1.4.0.34 FINAL: NuGet restore is NO LONGER REQUIRED for compilation. The only
       remaining package (microsoft.net.native.compiler) is an ILCompiler toolchain used at
       .NET Native (Release) link time; VS's own .NET Native toolset covers Debug builds, and
       the compiler package resolves via obj\*.nuget.g.props/.targets imports above when a
       manual restore IS run. All previous WMC1006/WMC9999 'System.Runtime' failures came from
       NuGet-sourced facade DLLs shadowing SDK reference assemblies; with zero compile-time
       package references the universe is pure Windows SDK, so the old self-heal target keyed
       on newtonsoft.json.12.0.3 was removed instead of being left to fail spuriously. -->
  <Target Name="EnsurePackagesRestored" BeforeTargets="ResolveAssemblyReferences">
    <Message Importance="low" Text="v1.4.0.35: no compile-time NuGet dependencies - restore skipped." />
  </Target>
  <!-- v1.4.0.35 STALE-BUILD-STATE GUARD. Evidence from the user's machine on v1.4.0.34
       (packages folder deleted by hand, metapackage long gone, zero <Reference> items):
       WMC1006/WMC9999 'System.Runtime' STILL fired. The only remaining way a pure-SDK UAP
       project can see a wrong System.Runtime is leftover state from older tree layouts:
         - obj\*.nuget.g.props/.targets from a pre-v1.4.0.32 restore (imported above when
           present) which re-add PackageReference-style facade paths, and/or
         - stale XamlCompiler cache under obj\.
       This target deletes such residue BEFORE ResolveAssemblyReferences so every build
       starts from a clean, SDK-only type universe. It touches ONLY generated files
       (obj\bin\packages), never sources. -->
  <Target Name="PurgeStaleRestoreState" BeforeTargets="EnsurePackagesRestored">
    <ItemGroup>
      <_StaleNuGetProps Include="$(MSBuildProjectDirectory)\obj\*.nuget.g.props;$(MSBuildProjectDirectory)\obj\*.nuget.g.targets;$(MSBuildProjectDirectory)\obj\*.nuget.cache" />
    </ItemGroup>
    <!-- All @() usages below are bare item-list expressions (allowed anywhere);
         no item METADATA %(...) appears in any Condition - that was the exact
         MSB4092 defect class removed in v1.4.0.33. -->
    <Delete Files="@(_StaleNuGetProps)" ContinueOnError="WarnAndContinue" />
    <RemoveDir Directories="$(MSBuildProjectDirectory)\obj\XamlPreCompile" Condition="Exists('$(MSBuildProjectDirectory)\obj\XamlPreCompile')" ContinueOnError="WarnAndContinue" />
    <Message Importance="high" Text="PurgeStaleRestoreState: removed residual obj restore state (@(_StaleNuGetProps->'%(Filename)%(Extension)', ', ')). One-time manual cleanup of Barometer_UWP\obj, bin and ..\packages is still recommended." Condition="'@(_StaleNuGetProps->Count())' > 0" />
  </Target>
</Project>
